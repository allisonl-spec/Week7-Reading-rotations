<!doctype html><html lang="en-NZ"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Term 4 · Week 7 Reading Taskboard</title><style>
:root{--navy:#1b2348;--purple:#6345cb;--mint:#b7f3da;--peach:#ffb28a;--paper:#f6f3fd;--ink:#182341}*{box-sizing:border-box}body{margin:0;font:16px/1.55 system-ui,-apple-system,Arial,sans-serif;background:var(--paper);color:var(--ink)}.wrap{max-width:1120px;margin:auto;padding:0 20px}header{background:linear-gradient(135deg,#202a51,#643fba);color:white;padding:38px 0 27px;border-bottom:9px solid var(--mint)}header h1{font-size:clamp(42px,7vw,77px);line-height:1.03;margin:12px 0}header h1 span{color:var(--peach)}.eyebrow,.tag{font-size:12px;letter-spacing:1.5px;text-transform:uppercase;font-weight:900}.eyebrow{color:var(--mint)}.tag{color:var(--purple)}nav{display:flex;flex-wrap:wrap;gap:10px;margin:15px 0}button{border:2px solid #5c48b3;color:var(--ink);background:white;border-radius:15px;padding:12px 15px;font:inherit;font-weight:800;cursor:pointer}button[aria-pressed=true]{color:white;background:var(--purple);border-color:var(--purple)}header button[aria-pressed=true]{background:var(--peach);color:var(--navy);border-color:var(--peach)}button:focus-visible,a:focus-visible{outline:3px solid #f19a56;outline-offset:3px}.groupnav button,.sessionnav button{flex:1;min-width:150px}.sessionnav small{display:block;font-size:12px;font-weight:500}.panel{background:white;border:1px solid #e0ddef;border-radius:19px;padding:24px;margin:20px 0;box-shadow:0 5px 0 #e4def2}.panel h2{margin:5px 0 12px;font-size:clamp(23px,3vw,32px)}li{margin:9px 0}.notice{padding:13px 16px;background:#fff5d9;border-left:5px solid #e9b846;border-radius:9px;margin:15px 0}.good{padding:13px 16px;background:#e6fbf0;border-left:5px solid #62bd9a;border-radius:9px;margin:15px 0}.action,.roomlink{display:inline-block;background:#ece7ff;color:#32217a;border:1px solid #b3a9e6;border-radius:30px;padding:10px 15px;margin:6px 8px 6px 0;font-weight:800;text-decoration:none}.roomlink{background:var(--mint);border:0}.bookexample{position:relative;max-width:730px;border:1px solid #c6c6c6;border-radius:4px;padding:18px 20px 32px 83px;background:#fffefb repeating-linear-gradient(to bottom,transparent 0,transparent 35px,#8fb6df 35px,#8fb6df 36px);font:19px/36px 'Comic Sans MS','Segoe Print',Georgia,serif}.bookexample:before{content:'';position:absolute;top:0;bottom:0;left:63px;width:2px;background:#d84a58}.bookexample p{margin:0;min-height:36px;position:relative;top:4px}.bookexample u{text-decoration-color:#d84a58;text-underline-offset:4px}.muted{color:#5d6480}.pill{display:inline-block;background:#fff0d9;padding:4px 11px;border-radius:25px;font-weight:800}.footer{text-align:center;color:#6d7181;padding:25px}.story-covers{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:22px 0}.story-cover{background:#fff;color:#202a51;border-radius:14px;overflow:hidden;box-shadow:0 5px 15px #10152a45}.story-cover img{width:100%;height:150px;object-fit:cover;object-position:center top;display:block}.story-cover .cover-label{padding:8px;font-weight:800;font-size:13px;line-height:1.3}.story-cover .cover-group{display:block;color:#6847a7;font-size:12px;margin-bottom:3px}.tumble-scroll{overflow-x:auto;padding-bottom:6px}.tumble-grid{display:grid;grid-template-columns:minmax(120px,1fr) repeat(4,minmax(155px,1fr));gap:7px;min-width:790px}.tumble-head{padding:12px 8px;text-align:center;border-radius:13px;color:#25204d;font-weight:900}.tumble-head.time{background:#d8d1f6}.tumble-head.g0{background:#c9f1dc}.tumble-head.g1{background:#ffe0c3}.tumble-head.g2{background:#d7e7ff}.tumble-head.g3{background:#f1d8fa}.tumble-day{padding:12px 9px;background:#32275e;color:white;border-radius:12px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;font-weight:850}.tumble-cell{border:2px solid transparent;border-radius:13px;padding:12px 10px;text-align:left;cursor:pointer;min-height:84px;font:inherit;color:#27244b;display:flex;flex-direction:column;gap:5px;align-items:flex-start;justify-content:center}.tumble-cell:hover{border-color:#7250ba}.tumble-cell.g0{background:#e5f8ec}.tumble-cell.g1{background:#fff0e0}.tumble-cell.g2{background:#eaf2ff}.tumble-cell.g3{background:#f8eafb}.tumble-cell.selected{border-color:#6947ae;box-shadow:0 0 0 2px #6947ae35}.tumble-cell .activity-icon{font-size:24px;line-height:1}.tumble-cell .activity-name{font-weight:800;font-size:13px;line-height:1.3}.embedded-reader{padding:18px;background:#f5f1ff;border-radius:15px;margin:16px 0}.audio-panel{background:#e4faef;border-radius:12px;padding:14px;margin:14px 0}.audio-panel audio{width:100%;margin-top:8px}.story-frame{width:100%;height:68vh;min-height:430px;border:3px solid #c8baf4;border-radius:14px;background:white}.imagegrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:16px}.imagegrid figure{margin:0;background:#f6f2ff;border:2px solid #ded3fb;border-radius:13px;padding:9px}.imagegrid img{width:100%;display:block;border-radius:8px;cursor:zoom-in}.imagegrid figcaption{font-weight:750;font-size:14px;margin-top:8px}.modal[hidden]{display:none}.modal{position:fixed;inset:0;z-index:1000;background:#17152de8;display:grid;place-items:center;padding:55px 15px 15px}.modal img{max-width:100%;max-height:100%;object-fit:contain}.modal button{position:absolute;right:15px;top:12px;background:var(--peach)}.task-box{background:#f2edff;padding:15px 20px;border-radius:14px;margin:15px 0}.task-box.peach{background:#fff0e3}.task-box.mint{background:#e6fbf0}.task-box h3{margin:0 0 6px}.mini{font-size:13px;color:#625b78}details{padding:10px;background:#f2edff;border-radius:10px;margin:10px 0}details summary{cursor:pointer;font-weight:800}@media(max-width:620px){.panel{padding:16px}.bookexample{padding-left:51px;font-size:15px}.bookexample:before{left:38px}.story-covers{grid-template-columns:repeat(2,minmax(0,1fr))}.story-cover img{height:110px}.story-frame{height:55vh}}
.experts-tab{margin-top:18px;padding:17px 20px;border:2px solid #c9b5ef;border-radius:16px;background:linear-gradient(110deg,#f0eaff,#e4fbf4)}.experts-tab p{margin:10px 0 0;color:#302b51}.experts-link{display:inline-block;padding:11px 19px;border-radius:12px;background:#5931a5;color:#fff!important;font-weight:800;text-decoration:none}.experts-link:hover,.experts-link:focus{background:#40217c;outline:3px solid #b6a4e8;outline-offset:2px}</style></head><body><header><div class="wrap"><div class="eyebrow">Whaea Allie · Reading rotation</div><h1>Term 4 <span>Week 7</span></h1><p>Read • Respond • Explore • Reflect</p><nav id="classnav" aria-label="Choose classroom"></nav><a class="roomlink" id="classlink" target="_blank" rel="noopener">🏫 Open Google Classroom ↗</a><div class="story-covers" id="covers"></div></div></header><main class="wrap"><section class="panel"><div class="tag">Select your reading group</div><nav class="groupnav" id="groupnav" aria-label="Choose reading group"></nav><div class="good" id="groupstory"></div></section><section class="panel"><div class="tag">Week 7 · Lesson focus by group</div><h2>Our reading rotation</h2><p class="muted">Tap any activity in the grid to open that group’s lesson. Scroll sideways on smaller screens.</p><div class="tumble-scroll"><div class="tumble-grid" id="grid"></div></div><p class="mini">Talanoa with Whaea Allie: Tawa — Lesson 2; Southside — Lesson 4; Shooting Stars — Lesson 5; Kings & Queens — Lesson 3.</p></section><section class="panel"><div class="tag">Your five lessons</div><nav class="sessionnav" id="lessons"></nav><div class="experts-tab"><a class="experts-link" href="https://bairdcallumj-alt.github.io/poetandididntknowit/index.html" target="_blank" rel="noopener noreferrer">🌟 Extra for Experts ↗</a><p><strong>Poet and I Didn’t Know It:</strong> Listen to the songs, choose <strong>one</strong> that interests you, and complete the comprehension activities included in its tab. Share what you learned or discovered.</p></div></section><section class="panel" id="content" aria-live="polite"></section></main><div id="zoom" class="modal" hidden><button type="button" onclick="document.getElementById('zoom').hidden=true">Close ✕</button><img id="zoomimg" alt="Enlarged letter-writing poster"></div><footer class="footer">Term 4 · Week 7 · R13 · R62 · R81 · Whaea Allie</footer><script>
const books={"Tawa":{"title":"Queen of the Board","author":"Anahera Gildea","pdf":"assets/tawa.pdf","audio":"assets/tawa.mp3","questions":["Why does Miri call her sister “Tianiwha”?","How does Miri use her imagination when playing chess?","What does Tiana learn by the end of the story?"]},"Southside":{"title":"Stealing Maru","author":"Maria Samuela","pdf":"assets/southside.pdf","audio":"assets/southside.mp3","questions":["Why do the people of Aitutaki want Maru?","How do the warriors try to steal the maunga?","Why do the people of Puaikura eventually stop feeling angry?","What does the name Maru mean, and how does the mountain help the people of Puaikura?","Who are Vaeruarangi and Tamatoa, and what do they order their warriors to do?","How do the warriors use nature to navigate to Rarotonga?","Why do the warriors plan to arrive in the middle of the night?","What happens to pieces of Maru while the warriors escape through the village?","What name do the people of Aitutaki give the mountain, and what does it mean?","How does losing part of Maru unexpectedly improve life in Puaikura? Give two details."]},"Shooting Stars":{"title":"Best Wedding Ever","author":"Victor Rodger","pdf":"assets/shooting-stars.pdf","audio":"assets/shooting-stars.mp3","questions":["Why is chocolate cake so important to Levi?","Describe two things that go wrong at the wedding.","How does the ending show what matters most to Levi and his dads?","How does Levi feel about weddings at the beginning, and how can you tell?","Why do Dad and Papa Pita seem both hopeful and scared when they tell Levi about their wedding?","What confusion happens over the role of best man?","Choose one funny moment from the wedding preparations. How does the author make it humorous?","How does Levi’s first-person narration influence the way we understand the events?","Find a line of dialogue that reveals how a character feels. Explain your choice.","What do you think the story suggests about what makes a wedding or family celebration meaningful? Use evidence."]},"Kings & Queens":{"title":"Pākehā Tapu Day","author":"J. Wiremu Kane","pdf":"assets/kings-queens.pdf","audio":"assets/kings-queens.mp3","questions":["Why does Pāpā call Sunday the Pākehā tapu day?","Why are Mawhiti and Oma worried about visiting Mr Earle?","How does the story show the relationship between Te Whareumu and Mr Earle?","Where and when is the story set? Identify two details that establish its historical setting.","What are Pāpā and his people preparing for at the beginning of the story?","Why does Mr Earle think the men will rest on Sunday, and what is actually happening?","Explain the misunderstanding involving the tōtara shavings and Mr Earle’s hen.","How does Mawhiti feel about Mr Earle’s artwork? Support your answer with a detail.","Find one example of humour or irony in the story and explain how it works.","What does the story reveal about the different customs and perspectives of Māori and Pākehā characters? Use two pieces of evidence."]}},posters=["assets/future-self-poster-1.jpg", "assets/future-self-poster-2.jpg", "assets/future-self-poster-3.jpg"];rotation=[["Letter to My Future Self", "Letter to My Future Self", "Letter to My Future Self", "Letter to My Future Self"], ["Talanoa with Whaea Allie", "Reading & Comprehension", "Reading & Comprehension", "Reading & Comprehension"], ["Reading & Comprehension", "Dictionary Hunt", "Language Features", "Talanoa with Whaea Allie"], ["Language Features", "Talanoa with Whaea Allie", "Dictionary Hunt", "Language Features"], ["Dictionary Hunt", "Language Features", "Talanoa with Whaea Allie", "Dictionary Hunt"]]
const groups=['Tawa','Southside','Shooting Stars','Kings & Queens'];
const classrooms={R13:'https://classroom.google.com/c/ODQ2MjQ5MjMxMjU5',R62:'https://classroom.google.com/c/ODI2MDE2MTg3MzEw',R81:'https://classroom.google.com/c/ODI2MDMwMzE3Nzg2'};
let classroom='R13',group='Tawa',lesson=0;const $=x=>document.getElementById(x);const icons={'Letter to My Future Self':'💌','Reading & Comprehension':'📖','Talanoa with Whaea Allie':'🗣️','Dictionary Hunt':'🔎','Language Features':'✨'};
function blobFor(g,kind){return books[g][kind]}
function chooseGroup(g){group=g;render()}function chooseLesson(i){lesson=i;render();$('content').scrollIntoView({behavior:'smooth',block:'start'})}function chooseClass(k){classroom=k;render()}
function notebook(title){return `<h3>📓 Set out your exercise book neatly</h3><p class="muted">Start at the red margin, underline the date and title, and write full sentences across the lines.</p><div class="bookexample"><p><u>Date: ____________________</u></p><p><u>${title}</u></p><p>1. _________________________</p><p>2. _________________________</p></div>`}
function reader(g){let b=books[g];return `<div class="embedded-reader"><h3>📚 ${b.title}</h3><p>By ${b.author}</p><div class="audio-panel"><strong>🎧 Listen to your story</strong><audio controls preload="none" id="storyaudio"></audio><p class="mini">Use play, pause and replay to support your reading.</p></div><p><button type="button" class="action" onclick="openPdf()">🔍 Open full-size text</button></p><iframe class="story-frame" id="storyframe" title="${b.title} reading pages"></iframe><p class="mini">The story and audio are included inside this website and do not require separate file uploads.</p></div>`}
function openPdf(){window.open(blobFor(group,'pdf'),'_blank','noopener')}
function activity(){const focus=rotation[lesson][groups.indexOf(group)],b=books[group];let body=`<span class="pill">${classroom} · ${group} · Lesson ${lesson+1}</span><h2>${icons[focus]} ${focus}</h2>`;
if(focus==='Letter to My Future Self'){
 body+=`<div class="task-box mint"><h3>💌 A letter for the person you will become</h3><p>Everyone begins Week 7 with this writing lesson. This replaces the handwriting activity for Southside, Shooting Stars and Kings & Queens.</p><ol><li>Write the date and title <strong>Letter to My Future Self</strong>.</li><li>Begin with <strong>Dear Future Me,</strong>.</li><li>Describe what your life is like now: your interests, friendships, strengths and favourite memories.</li><li>Write about your hopes and goals, and what you want to achieve.</li><li>Give your future self kind advice and encouragement.</li><li>Sign off with <strong>From,</strong> and your name. Reread and edit your letter.</li></ol></div><h3>🖼️ Letter-writing posters</h3><p>Tap a poster to see it full-size.</p><div class="imagegrid">${posters.map((_,i)=>`<figure><img src="${posters[i]}" onclick="zoomPoster(${i})" alt="Letter to My Future Self poster ${i+1}" loading="lazy"><figcaption>${['Planning guide','Letter structure','Ideas and reminders'][i]}</figcaption></figure>`).join('')}</div>${notebook('Letter to My Future Self')}<div class="task-box peach"><strong>Starter:</strong> Dear Future Me, Right now, I am proud of… One thing I hope you have achieved is…</div>`;
}else if(focus==='Talanoa with Whaea Allie'){
 body+=`<div class="good"><strong>Teacher-led reading session</strong><p>Bring your reading text and reading book to Whaea Allie. Read together, practise strategies, talk about the meaning, and agree on a reading goal.</p></div>${reader(group)}<div class="task-box peach"><h3>While you wait</h3><p>Read your story quietly, listen to its audio if you have headphones, or finish an earlier task. Do not interrupt another group’s conference.</p></div><div class="notice"><strong>${group==='Tawa'?'Tawa:':'Your group:'}</strong> Check your reading and comprehension lesson in the rotation.</div>`;
}else if(focus==='Reading & Comprehension'){
 body+=`<div class="good">Read <strong>${b.title}</strong> by ${b.author}. Follow the story as you listen, then answer in your reading book.</div>${reader(group)}<div class="task-box peach"><h3>✏️ Comprehension questions</h3>${group==='Tawa'?'':'<p><strong>Answer all 10 questions.</strong> Write in full sentences and support your thinking with evidence from the story.</p>'}<ol>${b.questions.map(q=>`<li>${q}</li>`).join('')}${group==='Tawa'?'<li>Choose one answer and include evidence or a detail from the text to support it.</li>':''}</ol></div>${notebook(b.title+' — Comprehension')}`;
}else if(focus==='Independent Reading'){body+=`<div class="task-box mint"><h3>📚 Independent reading and catch-up</h3><p>Read independently using your story or a suitable book. Finish any incomplete comprehension, language-features or dictionary work. Write a 3-sentence summary of what you read.</p></div>`;
}else if(focus==='Dictionary Hunt'){
 const vocab={
 'Tawa':['championship','strategy','diagonally','concentrate','imagination'],
 'Southside':['majestic','sheltered','envy','ariki','crumbling','revenge'],
 'Shooting Stars':['ambrosia','groomsmen','celebrant','elope','beckoned','vicious','honoured','tradition','‘ie faitaga'],
 'Kings & Queens':['rangatira','sabbath','kāinga','waka taua','tinder','profusely','mortified','renowned','deft','caulking','cartridges','relaying']
 };
 const words=vocab[group];
 body+=`<div class="task-box mint"><h3>🔎 Dictionary Hunt — ${b.title}</h3><p>Investigate these <strong>${words.length} challenging words or expressions</strong> connected to your reading text.</p><ol>${words.map(w=>`<li><strong>${w}</strong></li>`).join('')}</ol><p><strong>Instructions:</strong> Locate each word in the story where possible; use a dictionary, glossary or reliable reference to find its meaning in context. Record the word, its meaning and a sentence of your own. If you cannot find a word exactly in the text, mark it as related vocabulary rather than a direct quotation.</p><p>${group==='Tawa'?'Use two words in your own sentences.':group==='Southside'?'Use three words in your own sentences.':group==='Shooting Stars'?'Use four words in your own sentences.':'Use five words in your own sentences and identify cultural or historical terms.'}</p></div>${notebook('Dictionary Hunt — '+b.title)}<button class="action" onclick="showReference()">📖 Show my reading text</button><div id="reference"></div>`;
}else{
 const features={
 'Tawa':[['2 adjectives','Find two describing words from the story.'],['2 action verbs','Find two words that show what a character does.'],['1 dialogue example','Copy one line a character says, including speech marks.']],
 'Southside':[['2 adjectives','Find words describing Maru, the landscape or the warriors.'],['2 powerful verbs','Find vivid action words.'],['1 simile','Find a comparison using like or as, if present.'],['1 personification','Find a description that makes Maru seem human or like a guardian, if present.'],['2 repeated phrases','Find repeated words or sentence beginnings.']],
 'Shooting Stars':[['2 examples of humour','Find moments or descriptions intended to amuse.'],['2 examples of dialogue','Find speech that reveals character personality.'],['2 idioms or informal expressions','Look for figurative everyday phrases.'],['2 examples of exaggeration','Find dramatic descriptions or overstatements.'],['2 examples of characterisation','Find clues about Levi or his dads.']],
 'Kings & Queens':[['2 examples of irony','Look for a gap between what someone believes and what is actually happening.'],['2 examples of contrast','Compare different attitudes towards customs or rest.'],['2 examples of dialogue','Choose exchanges that reveal attitudes.'],['2 examples of imagery','Find descriptions that help you picture the setting.'],['2 examples of characterisation','Find words or actions revealing Mawhiti or Mr Earle.'],['2 cultural or historical expressions','Find and explain terms such as rangatira, waka taua or kāinga.']]
 };
 let fs=features[group];
 body+=`<div class="task-box peach"><h3>✨ Language Features Hunt — ${b.title}</h3><p>Find <strong>${fs.reduce((n,x)=>n+Number(x[0].split(' ')[0]),0)} examples</strong> of the specific features below in your story.</p><ol>${fs.map(([name,help])=>`<li><strong>${name}:</strong> ${help}</li>`).join('')}</ol><p><strong>Record:</strong> Copy each short example accurately, label the language feature and ${group==='Tawa'?'underline the describing or action words.':'explain how the author’s choice influences meaning or the reader.'} If a technique is not present, write “not found” and explain what you looked for; do not invent a quotation.</p></div>${notebook('Language Features — '+b.title)}<button class="action" onclick="showReference()">📖 Show my reading text</button><div id="reference"></div>`;
}return body}
function showReference(){$('reference').innerHTML=reader(group);activateReader()}
function activateReader(){if($('storyframe'))$('storyframe').src=blobFor(group,'pdf');if($('storyaudio'))$('storyaudio').src=blobFor(group,'audio')}
function zoomPoster(i){$('zoomimg').src=posters[i];$('zoom').hidden=false}
function render(){
 $('classnav').innerHTML=Object.keys(classrooms).map(k=>`<button aria-pressed="${classroom===k}" onclick="chooseClass('${k}')">${k}</button>`).join('');$('classlink').href=classrooms[classroom];
 $('groupnav').innerHTML=groups.map(g=>`<button aria-pressed="${group===g}" onclick="chooseGroup('${g.replace(/'/g,"\\'")}')">${g}</button>`).join('');
 $('groupstory').innerHTML=`<strong>${group} reading text:</strong> ${books[group].title} — ${books[group].author} · PDF + audio included`;
 $('grid').innerHTML=`<div class="tumble-head time">Lesson</div>${groups.map((g,i)=>`<div class="tumble-head g${i}">${g}</div>`).join('')}`+rotation.map((r,i)=>`<div class="tumble-day">Lesson ${i+1}</div>${r.map((a,j)=>`<button class="tumble-cell g${j} ${lesson===i&&group===groups[j]?'selected':''}" onclick="group=groups[${j}];chooseLesson(${i})"><span class="activity-icon">${icons[a]}</span><span class="activity-name">${a}</span></button>`).join('')}`).join('');
 $('lessons').innerHTML=rotation.map((r,i)=>`<button aria-pressed="${lesson===i}" onclick="chooseLesson(${i})">Lesson ${i+1}<small>${r[groups.indexOf(group)]}</small></button>`).join('');
 $('content').innerHTML=activity();activateReader();
}
function covers(){let imgs=[];for(const g of groups){let key=g+'_cover';if(!cache[key]){let doc=books[g]; /* story covers are represented by coloured cards, PDFs are in the reader */}imgs.push(`<div class="story-cover"><div class="cover-label"><span class="cover-group">${g}</span>📖 ${books[g].title}</div></div>`)}$('covers').innerHTML=imgs.join('')}
document.addEventListener('keydown',e=>{if(e.key==='Escape')$('zoom').hidden=true});covers();render();
</script></body></html>
